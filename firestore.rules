rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserRoot(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemoryCategory(category) {
      return category in [
        'Identity',
        'Preferences',
        'Life',
        'Active',
        'Relationships',
        'Milestones',
        'Behaviors'
      ];
    }

    function isValidMemorySource(source) {
      return source in ['Manual', 'Voice', 'Automatic'];
    }

    function isValidMemoryImportance(importance) {
      return importance in ['standard', 'important'];
    }

    function isValidConfirmationStatus(status) {
      return status in ['manual', 'voice', 'auto_saved', 'user_approved'];
    }

    function isValidKeywordsList(keywords) {
      return keywords is list
        && keywords.size() <= 16
        && (
          keywords.size() == 0
          || (keywords[0] is string && keywords[0].size() >= 1 && keywords[0].size() <= 48)
        );
    }

    function isValidMemoryRecord(data, userId, memoryId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'description',
          'category',
          'source',
          'importance',
          'confirmationStatus',
          'keywords',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'description',
          'category',
          'source',
          'importance',
          'confirmationStatus',
          'keywords',
          'createdAt',
          'updatedAt'
        ])
        && data.id == memoryId
        && isValidId(data.id)
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.description is string
        && data.description.size() >= 3
        && data.description.size() <= 600
        && isValidMemoryCategory(data.category)
        && isValidMemorySource(data.source)
        && isValidMemoryImportance(data.importance)
        && isValidConfirmationStatus(data.confirmationStatus)
        && isValidKeywordsList(data.keywords)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;

      match /memories/{memoryId} {
        allow get: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(memoryId)
          && isVerifiedOwner(userId)
          && isValidMemoryRecord(incoming(), userId, memoryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isValidId(userId)
          && isValidId(memoryId)
          && isVerifiedOwner(userId)
          && isValidMemoryRecord(incoming(), userId, memoryId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'description',
              'category',
              'keywords',
              'importance',
              'confirmationStatus',
              'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'description',
              'category',
              'source',
              'keywords',
              'importance',
              'confirmationStatus',
              'updatedAt'
            ])
          )
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isValidId(userId)
          && isValidId(memoryId)
          && isVerifiedOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
